# Copy this file to .env and fill in the two keys. Both have free tiers:
#   Groq:     https://console.groq.com/keys
#   Pinecone: https://app.pinecone.io
GROQ_API_KEY=
PINECONE_API_KEY=

# Optional overrides (defaults shown).
# PINECONE_INDEX=docqa-rag
# PINECONE_NAMESPACE=default
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# CHAT_MODEL=groq:openai/gpt-oss-120b
# PLAN_MODEL=groq:openai/gpt-oss-20b
# EMBEDDING_PROVIDER=pinecone
# EMBEDDING_MODEL=multilingual-e5-large
# EMBEDDING_DIM=1024
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TOP_K=5
# RERANKER=pinecone:bge-reranker-v2-m3   (leave the value empty to turn reranking off)
# RERANK_CANDIDATES=20
# MIN_SCORE=0.75

# Hosting (see render.yaml). Off by default, which suits running locally.
# WORKSPACES=on        give every browser its own private library
# ACCESS_CODE=         require this code before the app can be used
# MAX_UPLOAD_MB=100
# MAX_DOCUMENTS=0      documents allowed per library; 0 means no limit

# To use OpenAI instead (needs API credit; use a new PINECONE_INDEX name):
# OPENAI_API_KEY=
# CHAT_MODEL=openai:gpt-4o-mini
# PLAN_MODEL=openai:gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
